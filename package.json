{
  "name": "electron-flask-react-app",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "cd server && python3 server.py",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5001 && electron .",
    "build": "cd frontend && npm run build",
    "dist": "npm run build && electron-builder",
    "copy-frontend": "cp -r ./frontend/dist ./dist/frontend/",
    "package": "npm run build && electron-builder && npm run copy-frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "form-data": "^4.0.0"
  },
  "build": {
    "appId": "com.yourcompany.electron-flask-app",
    "productName": "learn.local",
    "directories": {
      "output": "release"
    },
    "files": [
        "electron/**/*",
        "main.js",
        "preload.js",
        "server/**/*",
        "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/**/*"]
      },
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}